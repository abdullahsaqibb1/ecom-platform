generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AdminRole {
  STAFF
  SUPERADMIN
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PROCESSING
  PAID
  FAILED
  REFUNDED
}

enum NotificationType {
  ORDER_PLACED
  PAYMENT_CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum InventoryMovementType {
  INITIAL
  ADJUSTMENT
  SALE
  CANCELLATION
  RETURN
  DAMAGE
  RESTOCK
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
}

enum DiscountScope {
  ALL_PRODUCTS
  PRODUCTS
  CATEGORIES
  COLLECTIONS
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String?
  email        String   @unique
  passwordHash String
  orders       Order[]
  sessions     CustomerSession[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Admin {
  id                 String              @id @default(uuid()) @db.Uuid
  name               String?
  email              String              @unique
  passwordHash       String
  role               AdminRole           @default(STAFF)
  mediaAssets        MediaAsset[]
  inventoryMovements InventoryMovement[]
  storefrontUpdates StorefrontSettings[]
  contentPageUpdates ContentPage[]
  orderDeletions     OrderDeletionLog[]
  sessions           AdminSession[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}


model CustomerSession {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash     String   @unique
  csrfTokenHash String
  expiresAt     DateTime
  revokedAt     DateTime?
  ipHash        String?
  userAgentHash String?
  createdAt     DateTime @default(now())
  lastSeenAt    DateTime @default(now())

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model AdminSession {
  id            String   @id @default(uuid()) @db.Uuid
  adminId       String   @db.Uuid
  admin         Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  tokenHash     String   @unique
  csrfTokenHash String
  expiresAt     DateTime
  revokedAt     DateTime?
  ipHash        String?
  userAgentHash String?
  createdAt     DateTime @default(now())
  lastSeenAt    DateTime @default(now())

  @@index([adminId, expiresAt])
  @@index([expiresAt])
}

model Category {
  id          String     @id @default(uuid()) @db.Uuid
  name        String     @unique
  slug        String     @unique
  description String?
  image       String?
  isActive    Boolean    @default(true)
  sortOrder   Int        @default(0)
  parentId    String?    @db.Uuid
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryTree")
  products    Product[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([parentId])
  @@index([isActive, sortOrder])
}

model Collection {
  id          String              @id @default(uuid()) @db.Uuid
  name        String
  slug        String              @unique
  description String?
  image       String?
  isActive    Boolean             @default(true)
  isFeatured  Boolean             @default(false)
  sortOrder   Int                 @default(0)
  products    CollectionProduct[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([isActive, sortOrder])
}

model CollectionProduct {
  collectionId String     @db.Uuid
  productId    String     @db.Uuid
  position     Int        @default(0)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@id([collectionId, productId])
  @@index([productId])
  @@index([collectionId, position])
}

model Product {
  id                 String              @id @default(uuid()) @db.Uuid
  name               String
  slug               String              @unique
  description        String
  price              Decimal             @db.Decimal(12, 2)
  compareAtPrice     Decimal?            @db.Decimal(12, 2)
  costPrice          Decimal?            @db.Decimal(12, 2)
  stock              Int                 @default(0)
  lowStockThreshold  Int                 @default(5)
  images             String[]
  isActive           Boolean             @default(true)
  status             ProductStatus       @default(ACTIVE)
  isFeatured         Boolean             @default(false)
  brand              String?
  model              String?
  barcode            String?
  condition          String?             @default("NEW")
  warrantyMonths     Int?
  compatibility      String[]
  specifications     Json?
  highlights         String[]
  whatsInBox         String[]
  seoTitle           String?
  seoDescription     String?
  color              String?
  material           String?
  careInstructions   String[]
  tags               String[]
  categoryId         String?             @db.Uuid
  category           Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  collections        CollectionProduct[]
  variants           ProductVariant[]
  orderItems         OrderItem[]
  inventoryMovements InventoryMovement[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([categoryId])
  @@index([status, isActive, createdAt])
  @@index([brand])
  @@index([isFeatured, createdAt])
}

model ProductVariant {
  id                 String              @id @default(uuid()) @db.Uuid
  productId          String              @db.Uuid
  product            Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku                String              @unique
  size               String?
  color              String?
  price              Decimal?            @db.Decimal(12, 2)
  costPrice          Decimal?            @db.Decimal(12, 2)
  stock              Int                 @default(0)
  lowStockThreshold  Int                 @default(3)
  barcode            String?
  compatibility      String[]
  specifications     Json?
  image              String?
  orderItems         OrderItem[]
  inventoryMovements InventoryMovement[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([productId])
  @@index([stock])
}

model InventoryMovement {
  id             String                @id @default(uuid()) @db.Uuid
  productId      String                @db.Uuid
  variantId      String?               @db.Uuid
  adminId        String?               @db.Uuid
  type           InventoryMovementType
  quantityChange Int
  stockAfter     Int
  reason         String?
  reference      String?
  product        Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant        ProductVariant?       @relation(fields: [variantId], references: [id], onDelete: SetNull)
  admin          Admin?                @relation(fields: [adminId], references: [id], onDelete: SetNull)
  createdAt      DateTime              @default(now())

  @@index([productId, createdAt])
  @@index([variantId, createdAt])
  @@index([type, createdAt])
}

model Discount {
  id                   String        @id @default(uuid()) @db.Uuid
  name                 String
  code                 String        @unique
  description          String?
  type                 DiscountType
  scope                DiscountScope @default(ALL_PRODUCTS)
  value                Decimal       @default(0) @db.Decimal(12, 2)
  minimumOrderAmount   Decimal?      @db.Decimal(12, 2)
  maximumDiscountAmount Decimal?     @db.Decimal(12, 2)
  startsAt             DateTime?
  endsAt               DateTime?
  usageLimit           Int?
  usageCount           Int           @default(0)
  perCustomerLimit     Int?
  productIds           String[]
  categoryIds          String[]
  collectionIds        String[]
  isActive             Boolean       @default(true)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@index([isActive, startsAt, endsAt])
}

model PaymentMethod {
  id                    String   @id @default(uuid()) @db.Uuid
  code                  String   @unique
  provider              String
  displayName           String
  description           String?
  instructions          String?
  isEnabled             Boolean  @default(false)
  requiresOnlinePayment Boolean  @default(false)
  sortOrder             Int      @default(0)
  configuration         Json?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([isEnabled, sortOrder])
}

model Order {
  id                String            @id @default(uuid()) @db.Uuid
  userId            String            @db.Uuid
  user              User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  status            OrderStatus       @default(PENDING)
  paymentStatus     PaymentStatus     @default(UNPAID)
  paymentProvider   String?
  paymentMethodCode String?
  paymentReference  String?
  paymentTracker    String?
  discountCode      String?
  discountTotal     Decimal           @default(0) @db.Decimal(12, 2)
  taxTotal          Decimal           @default(0) @db.Decimal(12, 2)
  subtotal          Decimal           @default(0) @db.Decimal(12, 2)
  shippingTotal     Decimal           @default(0) @db.Decimal(12, 2)
  total             Decimal           @db.Decimal(12, 2)
  customerNote      String?
  shippingAddress   Json
  shippingAddressEncrypted String?
  carrier           String?
  trackingNumber    String?
  trackingUrl       String?
  estimatedDelivery DateTime?
  paidAt            DateTime?
  shippedAt         DateTime?
  deliveredAt       DateTime?
  items             OrderItem[]
  paymentEvents     PaymentEvent[]
  notifications     NotificationLog[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([paymentStatus, createdAt])
  @@index([trackingNumber])
  @@index([discountCode])
}

model OrderItem {
  id           String          @id @default(uuid()) @db.Uuid
  orderId      String          @db.Uuid
  order        Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String          @db.Uuid
  product      Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantId    String?         @db.Uuid
  variant      ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)
  productName  String
  variantLabel String?
  unitPrice    Decimal         @db.Decimal(12, 2)
  quantity     Int
  unitCost     Decimal?        @db.Decimal(12, 2)

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}

model PaymentEvent {
  id        String   @id @default(uuid()) @db.Uuid
  orderId   String   @db.Uuid
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider  String
  eventId   String
  eventType String
  payload   Json
  createdAt DateTime @default(now())

  @@unique([provider, eventId])
  @@index([orderId, createdAt])
}

model NotificationLog {
  id                String             @id @default(uuid()) @db.Uuid
  orderId           String             @db.Uuid
  order             Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type              NotificationType
  status            NotificationStatus @default(PENDING)
  recipient         String
  providerMessageId String?
  error             String?
  sentAt            DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@unique([orderId, type])
  @@index([status, createdAt])
}

model MediaAsset {
  id               String   @id @default(uuid()) @db.Uuid
  publicId         String   @unique
  secureUrl        String   @unique
  format           String?
  width            Int?
  height           Int?
  bytes            Int?
  createdByAdminId String?  @db.Uuid
  createdBy        Admin?   @relation(fields: [createdByAdminId], references: [id], onDelete: SetNull)
  createdAt        DateTime @default(now())

  @@index([createdAt])
}


model StorefrontSettings {
  id                    String   @id @default("primary")
  siteName              String   @default("Cosmic Tech")
  logoUrl               String?
  logoAlt               String?
  faviconUrl            String?
  announcementText      String?
  announcementLinkLabel String?
  announcementLinkUrl  String?
  supportEmail          String?
  supportPhone          String?
  navigation            Json
  homepage              Json
  footer                Json
  theme                 Json
  updatedByAdminId      String?  @db.Uuid
  updatedBy             Admin?   @relation(fields: [updatedByAdminId], references: [id], onDelete: SetNull)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model ContentPage {
  id               String   @id @default(uuid()) @db.Uuid
  slug             String   @unique
  title            String
  eyebrow          String?
  body             String
  heroImage        String?
  sections         Json?
  seoTitle         String?
  seoDescription   String?
  isPublished      Boolean  @default(true)
  sortOrder        Int      @default(0)
  updatedByAdminId String?  @db.Uuid
  updatedBy        Admin?   @relation(fields: [updatedByAdminId], references: [id], onDelete: SetNull)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([isPublished, sortOrder])
}

model OrderDeletionLog {
  id               String   @id @default(uuid()) @db.Uuid
  orderId          String
  reason           String
  snapshot         Json
  deletedByAdminId String?  @db.Uuid
  deletedBy        Admin?   @relation(fields: [deletedByAdminId], references: [id], onDelete: SetNull)
  deletedAt        DateTime @default(now())

  @@index([orderId])
  @@index([deletedAt])
}
