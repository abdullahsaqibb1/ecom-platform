{
  "name": "ecom-backend",
  "private": true,
  "version": "1.0.0",
  "main": "api/index.js",
  "scripts": {
    "dev": "node --watch server.js",
    "start": "node server.js",
    "postinstall": "prisma generate",
    "vercel-build": "prisma generate && prisma migrate deploy && prisma db seed",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:reset-admin": "node prisma/reset-admin.js",
    "db:encrypt-pii": "node prisma/encrypt-order-addresses.js"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "@sfpy/node-core": "^0.3.5",
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.7.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "slugify": "^1.6.6",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "prisma": "^6.16.2"
  }
}
